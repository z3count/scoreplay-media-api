# =============================================================================
# Environment configuration template
# =============================================================================
#
# These values are the DEV DEFAULTS — copying this file to .env produces a
# working local setup that matches docker-compose.yml. For production, review
# every value (especially DATABASE_URL, API_KEY, TLS_*) before deploying.
#
# How config gets loaded:
#   - The Go app reads real environment variables (it does not auto-source
#     this file). Use `export $(grep -v '^#' .env | xargs)` or your shell of
#     choice to pick them up, or just rely on the built-in dev defaults baked
#     into config/config.go (they mirror the values below).
#   - docker-compose.yml DOES read .env automatically — set POSTGRES_USER /
#     POSTGRES_PASSWORD / POSTGRES_DB here to override the container defaults.
#
# NEVER commit .env to version control.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
LISTEN_ADDR=:8080
BASE_URL=http://localhost:8080

# Logging: "json" (production) or "text" (human-readable dev output)
LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# DEV DEFAULT — matches docker-compose.yml. The docker-compose Postgres does
# not terminate TLS, so sslmode=disable is required locally.
#
# PRODUCTION — replace credentials and use sslmode=require (or verify-full):
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=postgres://scoreplay:scoreplay@localhost:5432/media_api?sslmode=disable

# docker-compose service overrides (read by docker-compose, not by the Go app).
# Keep these aligned with DATABASE_URL above so `docker compose up` and the
# app connect to the same database.
POSTGRES_USER=scoreplay
POSTGRES_PASSWORD=scoreplay
POSTGRES_DB=media_api
POSTGRES_PORT=5432

# Database connection pool tuning.
# MaxOpenConns: upper bound on total connections (open + idle). Set based
# on your PostgreSQL max_connections (default 100) divided by instance count.
DB_MAX_OPEN_CONNS=25
# MaxIdleConns: connections kept alive for reuse. Higher = lower latency
# on bursty traffic, but more memory per idle conn (~5KB).
DB_MAX_IDLE_CONNS=5
# ConnMaxLifetime: recycle connections after this duration (seconds).
# Prevents stale connections after PostgreSQL restarts or failovers.
DB_CONN_MAX_LIFETIME=300
# ConnMaxIdleTime: close idle connections after this duration (seconds).
# Frees resources when traffic drops.
DB_CONN_MAX_IDLE_TIME=60

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Storage backend: "local" (default) or "s3"
STORAGE_BACKEND=local

# Local storage (used when STORAGE_BACKEND=local)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# S3 storage (used when STORAGE_BACKEND=s3)
# Also works with S3-compatible services (MinIO, DigitalOcean Spaces, R2).
S3_BUCKET=
S3_REGION=eu-west-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PREFIX=media/
S3_CDN_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Empty in dev = auth disabled. In PRODUCTION, set a strong key:
#   openssl rand -base64 32
# Rotate every 90 days, or immediately after a suspected compromise.
# Rotation procedure: set the new key, restart, then invalidate the old key.
API_KEY=

# -----------------------------------------------------------------------------
# Rate limiting (per-IP token bucket)
# -----------------------------------------------------------------------------
# RPS: sustained requests per second allowed per IP.
# BURST: maximum burst of requests before throttling kicks in.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=30

# -----------------------------------------------------------------------------
# Timeouts (seconds)
# -----------------------------------------------------------------------------
# Per-request context deadline. Limits how long a single request can run
# before its context is cancelled. Affects DB queries, storage ops, etc.
REQUEST_TIMEOUT=30

# Graceful shutdown timeout.
SHUTDOWN_TIMEOUT=30

# -----------------------------------------------------------------------------
# TLS (optional)
# -----------------------------------------------------------------------------
# Set both to enable HTTPS. In production, prefer a reverse proxy
# (nginx/Caddy) with TLS termination over terminating in-process.
TLS_CERT_FILE=
TLS_KEY_FILE=

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. Empty = no cross-origin allowed.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Background jobs
# -----------------------------------------------------------------------------
# Backend: "postgres" (default — in-process worker polls with SKIP LOCKED)
# or "sqs" (Enqueue sends to SQS; an external consumer / Lambda runs handlers).
JOB_QUEUE_BACKEND=postgres

# Whether to start the in-process worker. Only meaningful for the postgres
# backend. Set to "false" on API replicas that should only enqueue jobs
# (e.g., when a dedicated worker fleet handles processing).
JOB_WORKER_ENABLED=true

# Number of concurrent polling goroutines. Each picks one job at a time
# via SELECT FOR UPDATE SKIP LOCKED, so they never collide.
JOB_WORKER_CONCURRENCY=4

# Polling cadence per goroutine, in seconds. Lower = faster pickup at idle
# cost; higher = less DB load. 2s is a sane default for moderate throughput.
JOB_POLL_INTERVAL=2

# Completed/failed jobs are deleted after this many days by the cleanup loop.
JOB_RETENTION_DAYS=7

# Cleanup loop cadence in hours.
JOB_CLEANUP_INTERVAL=24

# Queue-depth gauge sampling cadence in seconds (job_queue_pending,
# job_queue_oldest_pending_age_seconds).
JOB_STATS_INTERVAL=15

# SQS configuration — only used when JOB_QUEUE_BACKEND=sqs.
SQS_QUEUE_URL=
SQS_REGION=
